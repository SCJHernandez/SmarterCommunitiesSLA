# Copy to .env.local and fill in. Next.js loads .env.local automatically; in Azure, set the same names as
# App Service application settings. Only NEXT_PUBLIC_* values reach the browser (fixed at build time).

# ── Public (all optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_PORTAL_NAME=SLA Performance
# Dynamics 365 org and model-driven app used for "Open in Dynamics" links
# NEXT_PUBLIC_CRM_BASE_URL=https://smartercommunities.crm6.dynamics.com
# NEXT_PUBLIC_CRM_APP_ID=4bdd0e5b-3187-4907-b71f-bb4e5e3bf8f0

# ── Dataverse (app registration, client credentials) ───────────────────────────
DATAVERSE_URL=https://<org>.crm6.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=

# ── Sign-in (Microsoft 365 / Entra ID) ─────────────────────────────────────────
# App registration used for user sign-in (web platform, redirect URI <app>/api/auth/callback,
# delegated permissions openid, profile, email, User.Read). Roles come from its App roles
# (values: Admin, Viewer) assigned under Enterprise applications → Users and groups.
# Falls back to GRAPH_* when not set.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# AUTH_TENANT_ID=          # defaults to GRAPH_TENANT_ID, then DATAVERSE_TENANT_ID
# Encrypts the session cookie. At least 32 random characters: `openssl rand -base64 48`
AUTH_SESSION_SECRET=
# Only these email domains may sign in (comma-separated)
AUTH_ALLOWED_EMAIL_DOMAINS=smartercommunities.com.au,smarterdirectory.com.au
# Role for people with no app role assigned (Viewer | Admin), or 'none' to turn them away
AUTH_DEFAULT_ROLE=Viewer
# AUTH_SESSION_HOURS=8
# Public address when behind a proxy / App Service (used for the redirect URI)
# AUTH_BASE_URL=https://sla.example.com
# Local development only (ignored in production builds): skip sign-in and act as an Admin
# AUTH_DISABLED=true

# ── Microsoft Graph, app-only (role list, profile photos) ──────────────────────
# Application permissions, with admin consent: User.Read.All, Application.Read.All.
# Falls back to the Dataverse app registration.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# Changing roles from the app uses the signed-in Admin's own consent instead
# (AppRoleAssignment.ReadWrite.All, Application.Read.All, User.ReadBasic.All — delegated).
